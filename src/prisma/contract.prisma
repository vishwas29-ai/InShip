
 // use prisma-8

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum AssignmentType {
  PICKUP
  DELIVERY
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  HANDED_OVER
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @onCreate(uuid())
  fullName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
}

model Order {
  id              String @id @onCreate(uuid())

  senderId        String?
  receiverId      String?
  receiverName    String?
  receiverPhone   String?
  receiverEmail   String?

  pickupAddress   String
  pickupPin       String
  deliveryAddress String
  deliveryPin     String

  distanceKm      Float
  billableKm      Int
  totalCharge     Int

  status          OrderStatus @default(PLACED)
  createdAt       DateTime @default(now())
}

model AgentAssignment {
  id          String @id @onCreate(uuid())
  orderId     String
  agentId     String

  type        AssignmentType
  status      AssignmentStatus @default(ASSIGNED)

  assignedAt  DateTime @default(now())
  completedAt DateTime?
}

model TrackingEvent {
  id          String @id @onCreate(uuid())
  orderId     String
  updatedById String?

  status      String
  description String
  location    String?

  createdAt   DateTime @default(now())
}
